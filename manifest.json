{
  "manifest_version": 3,
  "name": "Tab Vacuum",
  "version": "0.1.0",
  "description": "Find and vacuum away duplicate tabs, unused new tabs, and other junk across all your windows.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs"],
  "optional_permissions": ["tabGroups"],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Tab Vacuum",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  }
}
