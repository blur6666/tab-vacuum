{
  "manifest_version": 3,
  "name": "Tab Cleanup",
  "version": "0.1.0",
  "description": "Find unused new-tab pages and duplicate tabs across all your windows.",
  "minimum_chrome_version": "116",
  "permissions": [],
  "optional_permissions": ["tabs"],
  "action": {
