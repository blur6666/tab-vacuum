{
  "manifest_version": 3,
  "name": "Tab Vacuum! One click. Tab clutter gone.",
  "version": "1.1.0",
  "description": "Find unused new-tab pages and duplicate tabs across all your windows, then clean them up.",
  "minimum_chrome_version": "127",
  "permissions": ["tabs", "alarms", "storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "optional_permissions": ["tabGroups"],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Tab Vacuum",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
